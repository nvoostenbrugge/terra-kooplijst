# Terra Kooplijst - instellingen. Op de Mac mini maakt "10 - Kooplijst installeren.command" dit bestand aan.
SECRET_KEY=verander-mij
DEBUG=False
PORT=8091

# Database (leeg laten = SQLite in de projectmap, alleen voor ontwikkeling)
DB_NAME=terra_kooplijst
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Gedeeld geheim met TerraFlow (zelfde waarde als KOOPLIJST_SECRET in /opt/terraflow/.env).
# TerraFlow stuurt het mee bij elk doorgegeven verzoek; de kooplijst stuurt het mee bij pushmeldingen.
TERRAFLOW_SECRET=
TERRAFLOW_URL=http://127.0.0.1:8000

# Alleen voor ontwikkeling op je eigen pc (werkt alleen met DEBUG=True): doe alsof deze gebruiker is ingelogd
# DEV_USER=niek@example.com
# DEV_ADMIN=1
